# Cadentor Service 4 — environment contract.
# Copy to `.env` and fill in locally. Never commit real values.
# Blank values are treated as "not set". Variables marked [future] are
# accepted but not used until the phase that owns them.

# --- Runtime -----------------------------------------------------------------
# development | test | production (defaults to development)
NODE_ENV=
# debug | info | warn | error | fatal (defaults to info)
LOG_LEVEL=

# --- Database ----------------------------------------------------------------
# Required in production. Optional in development: /ready reports "not configured".
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# --- HTTP --------------------------------------------------------------------
# API listen port (defaults to 4000)
API_PORT=
# Allowed CORS origin for the operator UI (required in production)
WEB_URL=
# Public API base URL, also read by the web app (defaults to http://localhost:4000)
API_URL=

# --- AI ----------------------------------------------------------------------
# Reply classification and grounded answers. Unset = inbound replies are stored
# but not processed. OPENAI_MODEL is required when OPENAI_API_KEY is set.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Messaging ---------------------------------------------------------------
# twilio (unset = messaging disabled). When set, SMS_ACCOUNT_ID (Account SID),
# SMS_AUTH_TOKEN and SMS_FROM_NUMBER (E.164) are required, and API_URL must be
# the public URL Twilio calls. Configure the number's messaging webhook as
# <API_URL>/api/v1/webhooks/messaging/twilio/inbound
SMS_PROVIDER=
SMS_ACCOUNT_ID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# --- Booking / CRM / notifications [future: Phase 3] -------------------------
# Leave unset: no calendar adapter exists yet (a value stops startup). Booking
# links come from each campaign's "booking" config.
CALENDAR_PROVIDER=
# Leave unset: no CRM / notification adapter exists yet (a value stops startup).
# Booking deliveries are recorded and marked BLOCKED until an adapter is added.
CRM_PROVIDER=
OWNER_NOTIFICATION_PROVIDER=

# --- Campaign operations [future: Phase 1+] ----------------------------------
# IANA timezone fallback when a lead has none (defaults to America/New_York)
DEFAULT_CAMPAIGN_TIMEZONE=
# Local send window, HH:MM 24h (defaults 09:00 – 18:00)
CAMPAIGN_SEND_WINDOW_START=
CAMPAIGN_SEND_WINDOW_END=
# Max outbound messages per hour (defaults to 60)
CAMPAIGN_HOURLY_DISPATCH_LIMIT=
# Hours before a follow-up (defaults to 48)
CAMPAIGN_FOLLOW_UP_DELAY_HOURS=
# Days of silence before a lead is archived (defaults to 14)
CAMPAIGN_ARCHIVE_DELAY_DAYS=
# Minimum classifier confidence, 0–1 (defaults to 0.8)
CLASSIFIER_CONFIDENCE_THRESHOLD=

# --- Lead imports ------------------------------------------------------------
# Max CSV upload size in bytes (defaults to 10485760 = 10 MiB, max 100 MiB)
IMPORT_MAX_FILE_BYTES=

# --- Background jobs (pg-boss) -------------------------------------------------
# true | false (defaults to true). false runs the API without scheduler/workers.
JOB_WORKERS_ENABLED=
