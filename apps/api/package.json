    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.13",
    "openai": "^7.15.0",
    "pg-boss": "^12.31.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "twilio": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "embedded-postgres": "18.4.0-beta.17",
