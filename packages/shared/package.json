{
  "name": "@cadentor/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Contracts shared by the Cadentor API and web app. No backend internals.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
