// Cadentor Service 4 — database schema.
// Connection URL is configured in prisma.config.ts.
//
// Invariants that Prisma cannot express live in the migration SQL and are
// documented in docs/database.md: CHECK constraints (E.164 phone, lowercase
// email, suppression identity, import count totals), the partial unique index
// on processing imports, and the append-only trigger on SuppressionEntry.

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

/// Global lifecycle only. Campaign progress lives on CampaignLead.
enum LeadStatus {
  ACTIVE
  ARCHIVED
}

/// One record per real contact. Identity is the E.164 phone number.
model Lead {
  id                 String     @id @default(uuid(7)) @db.Uuid
  /// E.164, e.g. +14155552671. Unique contact identity.
  phone              String     @unique @db.VarChar(16)
  /// Trimmed and lowercased. Not unique: households share addresses.
  email              String?    @db.VarChar(254)
  firstName          String?    @db.VarChar(100)
  lastName           String?    @db.VarChar(100)
  /// Source label from the first import that created this lead.
  source             String     @db.VarChar(200)
  externalId         String?    @db.VarChar(200)
  lastServiceAt      DateTime?  @db.Date
  /// IANA timezone, only when the source genuinely provided one.
  timezone           String?    @db.VarChar(64)
  status             LeadStatus @default(ACTIVE)
  /// Operator human takeover (Phase 4): while set, no automated conversational
  /// or campaign message is sent to this lead. Opt-out handling and
  /// suppression still apply. Null = automation active.
  automationPausedAt DateTime?  @db.Timestamptz(3)
  firstImportBatchId String?    @db.Uuid
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  firstImportBatch    ImportBatch?      @relation(fields: [firstImportBatchId], references: [id], onDelete: SetNull)
  campaignMemberships CampaignLead[]
  importRows          ImportRowResult[]
  messages            Message[]
  replyProcessings    ReplyProcessing[]

  @@index([email])
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

/// Status changes only through apps/api/src/modules/campaigns/lifecycle.ts.
model Campaign {
  id              String         @id @default(uuid(7)) @db.Uuid
  name            String         @db.VarChar(200)
  status          CampaignStatus @default(DRAFT)
  /// CampaignConfig snapshot (Zod-validated), fixed at creation so later
  /// environment changes never alter a running campaign.
  config          Json
  statusChangedAt DateTime       @default(now()) @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  members       CampaignLead[]
  importBatches ImportBatch[]
  admissions    DispatchAdmission[]
  messages      Message[]
  knowledgeItems KnowledgeItem[]

  @@index([status])
}

/// Campaign-specific lifecycle. Transitions are validated in
/// apps/api/src/modules/campaigns/membership.ts — never assign status ad hoc.
enum CampaignLeadStatus {
  STAGED
  QUEUED
  STEP_1_SENT
  STEP_2_SENT
  ENGAGED
  QUALIFIED
  BOOKED
  OPTED_OUT
  DORMANT_ARCHIVED
}

model CampaignLead {
  id              String             @id @default(uuid(7)) @db.Uuid
  campaignId      String             @db.Uuid
  leadId          String             @db.Uuid
  status          CampaignLeadStatus @default(STAGED)
  statusChangedAt DateTime           @default(now()) @db.Timestamptz(3)
  importBatchId   String?            @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  campaign    Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  lead        Lead               @relation(fields: [leadId], references: [id], onDelete: Restrict)
  importBatch ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  admission   DispatchAdmission?
  messages    Message[]
  replyProcessings ReplyProcessing[]
  qualificationFacts       QualificationFact[]
  qualificationEvaluations QualificationEvaluation[]
  bookingOpportunities     BookingOpportunity[]
  integrationDeliveries    IntegrationDelivery[]

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  /// Scheduler candidate scan: oldest STAGED first, keyset-paged.
  @@index([campaignId, status, createdAt, id])
  @@index([leadId])
  /// Outbound dispatch scan: oldest QUEUED first.
  @@index([status, statusChangedAt])
}

// ---------------------------------------------------------------------------
// Dispatch admission (Phase 1 / Prompt 2)
// ---------------------------------------------------------------------------

enum TimezoneSource {
  LEAD
  CAMPAIGN
}

/// One row per STAGED → QUEUED admission. Records the decision that admitted
/// the member and is the durable source for hourly capacity accounting.
/// QUEUED means approved for sending; nothing has been sent.
model DispatchAdmission {
  id                    String         @id @default(uuid(7)) @db.Uuid
  campaignId            String         @db.Uuid
  /// UNIQUE: a membership can be admitted at most once.
  campaignLeadId        String         @unique @db.Uuid
  admittedAt            DateTime       @db.Timestamptz(3)
  /// IANA zone used for the send-window decision.
  timezone              String         @db.VarChar(64)
  timezoneSource        TimezoneSource
  /// Recipient local time (HH:MM) at admission.
  localTime             String         @db.Char(5)
  sendWindowStart       String         @db.Char(5)
  sendWindowEnd         String         @db.Char(5)
  hourlyLimit           Int
  /// Admissions for this campaign already in the rolling hour before this one.
  priorAdmissionsInHour Int
  /// Background job that performed the admission, when there was one.
  jobId                 String?        @db.VarChar(64)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignLead CampaignLead @relation(fields: [campaignLeadId], references: [id], onDelete: Restrict)

  @@index([campaignId, admittedAt])
}

// ---------------------------------------------------------------------------
// Suppression (global, permanent, append-only)
// ---------------------------------------------------------------------------

enum SuppressionReason {
  OPT_OUT
  DO_NOT_CONTACT
  COMPLAINT
  LEGAL
  INVALID_CONTACT
}

enum SuppressionSource {
  IMPORT
  OPERATOR
  INBOUND_MESSAGE
  PROVIDER
}

/// At least one of phone/email is required (CHECK). Rows can never be updated
/// or deleted (trigger). Suppression applies across every campaign.
model SuppressionEntry {
  id        String            @id @default(uuid(7)) @db.Uuid
  phone     String?           @db.VarChar(16)
  email     String?           @db.VarChar(254)
  reason    SuppressionReason
  source    SuppressionSource
  /// External reference, e.g. provider message ID or ticket number.
  reference String?           @db.VarChar(200)
  note      String?           @db.VarChar(500)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@index([phone])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Imports
// ---------------------------------------------------------------------------

enum ImportSourceType {
  CSV
}

enum ImportBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// totalRows = acceptedCount + duplicateCount + suppressedCount + invalidCount
/// + failedCount is enforced by a CHECK constraint.
model ImportBatch {
  id              String            @id @default(uuid(7)) @db.Uuid
  sourceType      ImportSourceType
  sourceReference String?           @db.VarChar(255)
  sourceLabel     String            @db.VarChar(200)
  /// SHA-256 of the uploaded content. Unique while PROCESSING (partial index).
  contentHash     String            @db.Char(64)
  defaultCountry  String?           @db.Char(2)
  campaignId      String?           @db.Uuid
  status          ImportBatchStatus @default(PROCESSING)
  errorCode       String?           @db.VarChar(64)
  totalRows       Int               @default(0)
  /// CREATED + EXISTING rows.
  acceptedCount   Int               @default(0)
  /// CREATED rows (subset of accepted).
  newLeadCount    Int               @default(0)
  duplicateCount  Int               @default(0)
  suppressedCount Int               @default(0)
  invalidCount    Int               @default(0)
  failedCount     Int               @default(0)
  /// Campaign memberships created by this batch.
  stagedCount     Int               @default(0)
  startedAt       DateTime          @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?         @db.Timestamptz(3)

  campaign      Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  rows          ImportRowResult[]
  createdLeads  Lead[]
  campaignLeads CampaignLead[]

  @@index([startedAt])
}

enum ImportRowOutcome {
  CREATED
  EXISTING
  DUPLICATE
  SUPPRESSED
  INVALID
  FAILED
}

enum ImportRowReason {
  MALFORMED_ROW
  MISSING_PHONE
  INVALID_PHONE
  PHONE_COUNTRY_REQUIRED
  DUPLICATE_IN_BATCH
  SUPPRESSED_PHONE
  SUPPRESSED_EMAIL
  PERSISTENCE_ERROR
}

/// One row per source row. No raw contact data is stored here.
model ImportRowResult {
  id            String           @id @default(uuid(7)) @db.Uuid
  importBatchId String           @db.Uuid
  /// 1-based data row number (header excluded, blank lines skipped).
  rowNumber     Int
  outcome       ImportRowOutcome
  reason        ImportRowReason?
  /// Optional input fields dropped because they were invalid.
  ignoredFields String[]
  leadId        String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, outcome])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Messaging (Phase 2 / Prompt 1)
// ---------------------------------------------------------------------------

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageChannel {
  SMS
}

enum MessagePurpose {
  CAMPAIGN_STEP_1
  INBOUND_REPLY
  /// Automated reply to one inbound message (Phase 2 / Prompt 2).
  CONVERSATIONAL_REPLY
  /// Configured question for one missing qualification field (Phase 3 / Prompt 1).
  QUALIFICATION_QUESTION
  /// Booking link for one booking opportunity (Phase 3 / Prompt 1).
  BOOKING_LINK
  /// Configured no-response closeout, one per membership (Phase 3 / Prompt 2).
  CAMPAIGN_STEP_2
}

/// Outbound: PENDING → SENDING → ACCEPTED → SENT → DELIVERED, or FAILED,
/// UNCERTAIN (provider outcome unknown; never resent automatically) or
/// CANCELLED (stopped before the provider was called). Inbound: RECEIVED.
/// ACCEPTED means the provider took the message, not that it was delivered.
enum MessageStatus {
  PENDING
  SENDING
  ACCEPTED
  SENT
  DELIVERED
  FAILED
  UNCERTAIN
  CANCELLED
  RECEIVED
}

/// How an inbound message was associated with campaign context.
enum InboundResolution {
  /// Exactly one campaign membership was messaged from the receiving number.
  MATCHED
  /// Several memberships qualify; left for later resolution, never guessed.
  AMBIGUOUS_CAMPAIGN
  /// Known lead, but no outbound campaign message from the receiving number.
  NO_CAMPAIGN
  UNKNOWN_SENDER
}

enum SafetyAction {
  HARD_OPT_OUT
}

/// One row per SMS in either direction. Constraints in the migration SQL.
model Message {
  id                String             @id @default(uuid(7)) @db.Uuid
  direction         MessageDirection
  channel           MessageChannel     @default(SMS)
  purpose           MessagePurpose
  status            MessageStatus
  provider          String             @db.VarChar(32)
  providerMessageId String?            @db.VarChar(64)
  leadId            String?            @db.Uuid
  campaignId        String?            @db.Uuid
  campaignLeadId    String?            @db.Uuid
  fromNumber        String             @db.VarChar(32)
  toNumber          String             @db.VarChar(32)
  /// Final rendered/received text. Null only for outbound sends cancelled before rendering.
  body              String?            @db.VarChar(1600)
  /// Logical send identity (`<campaignLeadId>:<purpose>`). UNIQUE: one logical send.
  sendKey           String?            @unique @db.VarChar(80)
  inboundResolution InboundResolution?
  safetyAction      SafetyAction?
  /// Provider error code or internal cancellation reason.
  errorCode         String?            @db.VarChar(64)
  sendingStartedAt  DateTime?          @db.Timestamptz(3)
  acceptedAt        DateTime?          @db.Timestamptz(3)
  sentAt            DateTime?          @db.Timestamptz(3)
  deliveredAt       DateTime?          @db.Timestamptz(3)
  failedAt          DateTime?          @db.Timestamptz(3)
  receivedAt        DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  lead          Lead?                  @relation(fields: [leadId], references: [id], onDelete: Restrict)
  campaign      Campaign?              @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignLead  CampaignLead?          @relation(fields: [campaignLeadId], references: [id], onDelete: Restrict)
  webhookEvents ProviderWebhookEvent[]
  /// Processing record when this is an inbound message.
  replyProcessing    ReplyProcessing? @relation("ReplyProcessingInbound")
  /// Processing record that produced this message when it is an automated reply.
  producedByProcessing ReplyProcessing? @relation("ReplyProcessingReply")
  /// Qualification evaluation triggered by this inbound message.
  qualificationEvaluation QualificationEvaluation?
  /// Booking opportunity whose link this outbound message carries.
  bookingOpportunity      BookingOpportunity?

  @@unique([provider, providerMessageId])
  /// Reply processing scan: unprocessed inbound messages, oldest first.
  @@index([direction, createdAt])
  @@index([leadId, createdAt])
  /// Mission Control campaign activity and last-activity lookups.
  @@index([campaignId, createdAt])
  @@index([campaignLeadId])
  @@index([status, sendingStartedAt])
}

enum WebhookEventKind {
  INBOUND_MESSAGE
  DELIVERY_STATUS
}

enum WebhookEventOutcome {
  PROCESSED
  /// Older or equal to the message's current delivery state; ignored.
  STALE
  /// No message with this provider id (e.g. send outcome was UNCERTAIN).
  UNKNOWN_MESSAGE
  /// A provider status this service does not track.
  IGNORED
}

/// Durable webhook idempotency and audit. Stores identifiers and status only,
/// never the raw provider payload.
model ProviderWebhookEvent {
  id                String              @id @default(uuid(7)) @db.Uuid
  provider          String              @db.VarChar(32)
  /// Deterministic key from provider identifiers; UNIQUE per provider.
  eventKey          String              @db.VarChar(160)
  kind              WebhookEventKind
  providerMessageId String              @db.VarChar(64)
  providerStatus    String?             @db.VarChar(32)
  errorCode         String?             @db.VarChar(64)
  outcome           WebhookEventOutcome
  messageId         String?             @db.Uuid
  receivedAt        DateTime            @db.Timestamptz(3)

  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([provider, eventKey])
  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Reply intelligence (Phase 2 / Prompt 2)
// ---------------------------------------------------------------------------

enum IntentClassification {
  POSITIVE_INTEREST
  SPECIFIC_QUESTION
  NOT_INTERESTED
  HARD_OPT_OUT
  AMBIGUOUS
}

enum ReplyProcessingStatus {
  /// Claimed by a worker (claimedAt); reclaimable once stale.
  PROCESSING
  /// Transient AI failure; will be retried up to the attempt limit.
  RETRY
  COMPLETED
  /// Needs a human. No semantic action beyond the recorded one was taken.
  ESCALATED
  /// Already handled deterministically (exact hard opt-out); AI not called.
  SKIPPED
}

/// The deterministic action the router chose. Never chosen by the model.
enum ReplyAction {
  OPT_OUT
  ENGAGE
  ANSWER_QUESTION
  CLOSE_DECLINED
  CLARIFY
  HUMAN_REVIEW
  /// Answer to an outstanding qualification question; handled by qualification,
  /// no generic reply sent (Phase 3 / Prompt 2).
  QUALIFICATION_ANSWER
}

enum EscalationReason {
  LOW_CONFIDENCE
  UNKNOWN_SENDER
  AMBIGUOUS_CAMPAIGN
  NO_CAMPAIGN
  CONVERSATION_CLOSED
  AWAITING_HUMAN_REVIEW
  NO_REPLY_TEMPLATE
  AMBIGUOUS_REPLY
  MISSING_KNOWLEDGE
  UNGROUNDED_ANSWER
  INVALID_AI_OUTPUT
  AI_UNAVAILABLE
  LEAD_SUPPRESSED
  INBOUND_TOO_OLD
  /// An operator has taken over the conversation (Phase 4).
  HUMAN_TAKEOVER
}

/// One logical processing run per inbound message (UNIQUE inboundMessageId).
/// Stores the validated analysis and the routed outcome, never model reasoning.
model ReplyProcessing {
  id               String                @id @default(uuid(7)) @db.Uuid
  inboundMessageId String                @unique @db.Uuid
  leadId           String?               @db.Uuid
  campaignLeadId   String?               @db.Uuid
  status           ReplyProcessingStatus
  /// Claim counter; a worker may only record results for its own attempt.
  attempts         Int                   @default(1)
  claimedAt        DateTime              @db.Timestamptz(3)
  classification   IntentClassification?
  confidence       Float?
  preferredTime    String?               @db.VarChar(200)
  specificQuery    String?               @db.VarChar(500)
  action           ReplyAction?
  escalationReason EscalationReason?
  /// Approved knowledge items the answer was grounded on.
  knowledgeItemIds String[]
  aiProvider       String?               @db.VarChar(32)
  aiModel          String?               @db.VarChar(100)
  aiRequestIds     String[]
  /// The automated reply this processing created, if any.
  replyMessageId   String?               @unique @db.Uuid
  errorCode        String?               @db.VarChar(64)
  completedAt      DateTime?             @db.Timestamptz(3)
  /// Human review resolution (Phase 4 / Prompt 2). An ESCALATED record is an
  /// open review while reviewResolvedAt is null. Written only by
  /// modules/reviews/resolution.ts; the routed outcome above is never rewritten.
  reviewResolvedAt DateTime?             @db.Timestamptz(3)
  reviewResolution ReviewResolution?
  /// Operator id from OPERATOR_TOKENS (never a credential).
  reviewResolvedBy String?               @db.VarChar(64)
  reviewNote       String?               @db.VarChar(500)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  inboundMessage Message       @relation("ReplyProcessingInbound", fields: [inboundMessageId], references: [id], onDelete: Restrict)
  replyMessage   Message?      @relation("ReplyProcessingReply", fields: [replyMessageId], references: [id], onDelete: Restrict)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  campaignLead   CampaignLead? @relation(fields: [campaignLeadId], references: [id], onDelete: Restrict)

  @@index([status, claimedAt])
  /// Mission Control review queue: escalations, newest first.
  @@index([status, createdAt])
  @@index([leadId, status])
  @@index([campaignLeadId, action])
}

/// How an operator closed a human review (Phase 4 / Prompt 2).
enum ReviewResolution {
  /// Clear human takeover and let eligible automation continue.
  RESUME_AUTOMATION
  /// Keep (or start) human takeover; the operator continues manually.
  KEEP_HUMAN_TAKEOVER
  /// Archive the membership through the transition service, where legal.
  ARCHIVE
  /// Handled outside the system; automation state unchanged.
  MARK_HANDLED
}

enum KnowledgeCategory {
  BUSINESS_PROFILE
  SERVICES
  PRICING
  HOURS
  LOCATION
  ELIGIBILITY
  POLICY
  INSURANCE
  FAQ
  APPROVED_CLAIM
  BOOKING_PROCESS
}

/// Operator-approved business fact. The only source for grounded answers.
model KnowledgeItem {
  id         String            @id @default(uuid(7)) @db.Uuid
  /// Null = applies to every campaign.
  campaignId String?           @db.Uuid
  category   KnowledgeCategory
  question   String?           @db.VarChar(300)
  content    String            @db.VarChar(2000)
  /// Lowercase retrieval hints supplied by the operator.
  keywords   String[]
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([active, campaignId])
}

// ---------------------------------------------------------------------------
// Qualification + booking conversion (Phase 3 / Prompt 1)
// ---------------------------------------------------------------------------

/// Where a qualification fact came from. Precedence (high → low):
/// OPERATOR, IMPORT = SYSTEM, CONVERSATION. Lower never overwrites higher.
enum QualificationFactSource {
  IMPORT
  OPERATOR
  CONVERSATION
  SYSTEM
}

/// One current value per membership and configured qualification field.
model QualificationFact {
  id              String                  @id @default(uuid(7)) @db.Uuid
  campaignLeadId  String                  @db.Uuid
  /// Field key from the campaign's qualification config.
  field           String                  @db.VarChar(20)
  /// JSON string, number or boolean, validated against the field type.
  value           Json
  source          QualificationFactSource
  /// Inbound message the value was extracted from (CONVERSATION only).
  sourceMessageId String?                 @db.Uuid
  /// When the value was stated; equal-precedence writes only move forward.
  observedAt      DateTime                @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)

  campaignLead CampaignLead @relation(fields: [campaignLeadId], references: [id], onDelete: Restrict)

  @@unique([campaignLeadId, field])
}

enum QualificationResult {
  PENDING_INFORMATION
  QUALIFIED
  NOT_QUALIFIED
}

enum ExtractionOutcome {
  EXTRACTED
  /// Every configured field was already known from a non-conversation source.
  NOT_REQUIRED
  INVALID_OUTPUT
  AI_UNAVAILABLE
}

/// One deterministic evaluation per triggering inbound message (UNIQUE).
/// The result comes from evaluateQualification, never from the model.
model QualificationEvaluation {
  id                 String              @id @default(uuid(7)) @db.Uuid
  campaignLeadId     String              @db.Uuid
  inboundMessageId   String              @unique @db.Uuid
  result             QualificationResult
  missingFields      String[]
  /// [{ field, requirement }] that failed.
  failedRequirements Json
  /// First missing field (config order) when PENDING_INFORMATION.
  nextField          String?             @db.VarChar(20)
  /// Fact values the evaluation used.
  facts              Json
  /// SHA-256 of the qualification rules snapshot.
  rulesHash          String              @db.Char(64)
  rulesSnapshot      Json
  extraction         ExtractionOutcome
  /// Extracted fields dropped: failed evidence checks or lower precedence.
  discardedFields    String[]
  aiModel            String?             @db.VarChar(100)
  aiRequestId        String?             @db.VarChar(100)
  errorCode          String?             @db.VarChar(64)
  evaluatedAt        DateTime            @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)

  campaignLead   CampaignLead @relation(fields: [campaignLeadId], references: [id], onDelete: Restrict)
  inboundMessage Message      @relation(fields: [inboundMessageId], references: [id], onDelete: Restrict)

  @@index([campaignLeadId, evaluatedAt])
}

/// OFFERED → CONFIRMED (verified provider booking) → CANCELLED; OFFERED → EXPIRED.
enum BookingStatus {
  OFFERED
  CONFIRMED
  CANCELLED
  EXPIRED
}

/// A booking link offered to a QUALIFIED membership and, once a trusted
/// provider event confirms it, the appointment. At most one OFFERED/CONFIRMED
/// row per membership (partial unique index in the migration SQL).
model BookingOpportunity {
  id                  String        @id @default(uuid(7)) @db.Uuid
  campaignLeadId      String        @db.Uuid
  status              BookingStatus
  /// Calendar provider name whose webhook events may confirm this booking.
  calendarProvider    String        @db.VarChar(32)
  /// Unguessable token placed on the booking link and echoed by the provider.
  bookingReference    String        @unique @db.VarChar(64)
  bookingUrl          String        @db.VarChar(1000)
  linkMessageId       String?       @unique @db.Uuid
  externalBookingId   String?       @db.VarChar(200)
  appointmentStartAt  DateTime?     @db.Timestamptz(3)
  appointmentEndAt    DateTime?     @db.Timestamptz(3)
  appointmentTimezone String?       @db.VarChar(64)
  /// Provider accepted the booking-link SMS (not proof of booking).
  sentAt              DateTime?     @db.Timestamptz(3)
  confirmedAt         DateTime?     @db.Timestamptz(3)
  cancelledAt         DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  campaignLead CampaignLead           @relation(fields: [campaignLeadId], references: [id], onDelete: Restrict)
  linkMessage  Message?               @relation(fields: [linkMessageId], references: [id], onDelete: Restrict)
  events       CalendarWebhookEvent[]
  deliveries   IntegrationDelivery[]

  /// One confirmed appointment per provider booking identity.
  @@unique([calendarProvider, externalBookingId])
  @@index([campaignLeadId])
}

enum CalendarEventKind {
  BOOKING_CREATED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
}

enum CalendarEventOutcome {
  PROCESSED
  /// Same booking state already recorded; nothing changed.
  ALREADY_APPLIED
  /// No booking opportunity matches the reference or booking id.
  UNMATCHED
  /// Reference, booking id, provider or invitee identity disagree.
  MISMATCH
  /// Opportunity or membership is not in a state this event may change.
  INVALID_STATE
}

/// Durable calendar webhook idempotency and booking audit. Identifiers and
/// appointment timing only, never the raw payload.
model CalendarWebhookEvent {
  id                   String               @id @default(uuid(7)) @db.Uuid
  provider             String               @db.VarChar(32)
  eventKey             String               @db.VarChar(240)
  kind                 CalendarEventKind
  externalBookingId    String               @db.VarChar(200)
  bookingReference     String?              @db.VarChar(64)
  appointmentStartAt   DateTime?            @db.Timestamptz(3)
  appointmentTimezone  String?              @db.VarChar(64)
  outcome              CalendarEventOutcome
  bookingOpportunityId String?              @db.Uuid
  receivedAt           DateTime             @db.Timestamptz(3)

  bookingOpportunity BookingOpportunity? @relation(fields: [bookingOpportunityId], references: [id], onDelete: Restrict)
  deliveries         IntegrationDelivery[]

  @@unique([provider, eventKey])
  @@index([bookingOpportunityId])
}

// ---------------------------------------------------------------------------
// Operational deliveries (Phase 3 / Prompt 2)
// ---------------------------------------------------------------------------

enum IntegrationEventType {
  BOOKING_CONFIRMED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
}

enum IntegrationDestination {
  CRM
  OWNER_NOTIFICATION
  POST_BOOKING_HANDOFF
}

/// PENDING/RETRY → PROCESSING → COMPLETED | RETRY | FAILED.
/// BLOCKED: no provider configured for the destination; nothing was sent.
enum IntegrationDeliveryStatus {
  PENDING
  PROCESSING
  COMPLETED
  RETRY
  FAILED
  BLOCKED
}

/// Durable outbox row for one logical external side effect of a booking event.
/// Written in the booking transaction; delivered asynchronously. Failures here
/// never change booking or membership state.
model IntegrationDelivery {
  id                   String                    @id @default(uuid(7)) @db.Uuid
  /// `<opportunityId|calendarEventId>:<eventType>:<destination>`. UNIQUE: one logical action.
  idempotencyKey       String                    @unique @db.VarChar(160)
  eventType            IntegrationEventType
  destination          IntegrationDestination
  campaignLeadId       String                    @db.Uuid
  bookingOpportunityId String                    @db.Uuid
  calendarEventId      String?                   @db.Uuid
  /// Minimal destination-specific data snapshot taken in the booking transaction.
  payload              Json
  status               IntegrationDeliveryStatus @default(PENDING)
  /// Claims so far; a worker records results only for its own attempt.
  attempts             Int                       @default(0)
  claimedAt            DateTime?                 @db.Timestamptz(3)
  nextAttemptAt        DateTime                  @db.Timestamptz(3)
  /// Provider that handled the last attempt.
  provider             String?                   @db.VarChar(32)
  lastErrorCode        String?                   @db.VarChar(64)
  externalReference    String?                   @db.VarChar(200)
  completedAt          DateTime?                 @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)

  campaignLead       CampaignLead          @relation(fields: [campaignLeadId], references: [id], onDelete: Restrict)
  bookingOpportunity BookingOpportunity    @relation(fields: [bookingOpportunityId], references: [id], onDelete: Restrict)
  calendarEvent      CalendarWebhookEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Restrict)

  /// Delivery scan: due work, oldest first.
  @@index([status, nextAttemptAt])
  @@index([bookingOpportunityId])
}

// ---------------------------------------------------------------------------
// Operator audit (Phase 4 / Prompt 2)
// ---------------------------------------------------------------------------

enum OperatorAction {
  CAMPAIGN_START
  CAMPAIGN_PAUSE
  CAMPAIGN_RESUME
  CAMPAIGN_COMPLETE
  HUMAN_TAKEOVER
  RESUME_AUTOMATION
  REVIEW_RESOLVED
  INTEGRATION_REQUEUE
}

enum AuditTargetType {
  CAMPAIGN
  LEAD
  REVIEW
  INTEGRATION
}

/// One row per successful manual operator action. Append-only (trigger in the
/// migration SQL). Identifiers and minimal metadata only: no credentials,
/// contact data or message bodies.
model OperatorAuditEvent {
  id         String          @id @default(uuid(7)) @db.Uuid
  /// Operator id from OPERATOR_TOKENS.
  actorId    String          @db.VarChar(64)
  actorRole  String          @db.VarChar(16)
  action     OperatorAction
  targetType AuditTargetType
  targetId   String          @db.VarChar(64)
  metadata   Json
  requestId  String?         @db.VarChar(128)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
}
